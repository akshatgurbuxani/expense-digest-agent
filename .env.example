# ---- Core ----
# NODE_ENV=development
# LOG_LEVEL=info
# LOG_PRETTY=true       # "true" for human-readable logs in dev
# SERVICE_NAME=

# ---- Postgres (required) ----
DATABASE_URL=postgresql://user:password@localhost:5432/db?schema=public

# ---- Redis / BullMQ (required) ----
REDIS_URL=redis://localhost:6379

# ---- API ----
# API_PORT=3000
# CORS_ORIGINS=http://localhost:5173
# AUTH_JWT_SECRET=change-me-in-prod-please-32-bytes-min  # min 16 chars

# ---- Encryption (required for Postgres repos) ----
# 32-byte key, base64-encoded. Generate: openssl rand -base64 32
# ENCRYPTION_KEY=

# ---- Plaid ----
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox

# ---- Anthropic / Claude ----
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-3-5-sonnet-latest
# LLM_FAKE=true           # "true" = deterministic fake LLM (no key needed)

# ---- Delivery: Resend (email) ----
# RESEND_API_KEY=
# DIGEST_FROM_EMAIL=digests@example.com

# ---- Delivery: Twilio (SMS) ----
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# TWILIO_TEST_TO=

# ---- MCP ----
# MCP_ACCESS_TOKEN=       # mint via: npm run mint-mcp-token -- --user-id=xxx

# ---- Frontend ----
# VITE_API_URL=http://localhost:3000
# VITE_AUTH_TOKEN=

# ---- Dev flags ----
DELIVERY_DRY_RUN=true     # log deliveries instead of sending
# LLM_FAKE=true            # uncomment if not set above

# ---- Gmail / Google OAuth (see docs/gmail-receipt-enrichment.md) ----
# GMAIL_INTEGRATION=true
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/gmail/callback
# GMAIL_PUBSUB_TOPIC=projects/your-project/topics/gmail-push
# GMAIL_PUBSUB_PUSH_AUDIENCE=https://your-api-host/webhooks/gmail
# GMAIL_TEST_REFRESH_TOKEN=
# GMAIL_TEST_ADDRESS=
# GMAIL_TEST_MESSAGE_ID=

# Safety gate for live sandbox demo
# DEMO_LIVE=1
