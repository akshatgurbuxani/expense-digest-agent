  "include": ["packages/*/src/**/*.ts", "apps/api/src/**/*.ts", "apps/workers/src/**/*.ts", "apps/scheduler/src/**/*.ts", "apps/mcp-server/src/**/*.ts", "apps/**/e2e/**/*.ts"]
